# ---- Supabase ----
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="Liva Style Crafts"
NEXT_PUBLIC_WHATSAPP_NUMBER=917907395466

# ---- Razorpay ----
# Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard > Settings > Webhooks (create endpoint /api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---- Resend ----
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be a verified domain/sender in Resend
RESEND_FROM_EMAIL="Liva Style Crafts <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=your-order-alerts@example.com

# ---- Google OAuth (configured in Supabase Auth > Providers > Google) ----
# No separate env vars needed here — the Google Client ID/Secret are entered
# directly in the Supabase dashboard, not in this app. See README.

# ---- Seed script only (scripts/seed.ts) ----
SOURCE_STORE_URL=https://livastyle.in
